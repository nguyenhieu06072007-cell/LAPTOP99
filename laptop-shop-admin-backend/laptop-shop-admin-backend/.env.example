PORT=4000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD="nguyenhieu99"
DB_NAME=laptop_shop

# Chuỗi ngẫu nhiên >= 32 ký tự, KHÔNG commit lên git
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Khoá tài khoản tạm thời khi đăng nhập sai liên tục
MAX_FAILED_LOGINS=5
LOCK_MINUTES=15

# Danh sách origin của frontend admin, cách nhau bằng dấu phẩy
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

UPLOAD_DIR=uploads
# Đặt 1 nếu chạy sau reverse proxy (nginx, cloudflare...)
TRUST_PROXY=0

# ==============================================================================
# CẤU HÌNH AI CHATBOT ASSISTANT (LAPTOP99 AI)
# ==============================================================================
# Nhà cung cấp AI: 'gemini' (mặc định) hoặc 'openai'
AI_PROVIDER=gemini

# Cấu hình Google Gemini (Khuyên dùng gemini-1.5-flash hoặc gemini-2.0-flash)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Cấu hình OpenAI (Tùy chọn thay thế)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
